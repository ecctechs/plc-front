/* ===== Import Shared Styles ===== */
@import './assets/shared-styles.css';

/* ===== Table Styles - Minimalist Blue-White Theme ===== */
/* Fixed layout prevents column width shifts on language/content change */
.table {
  table-layout: fixed;
  width: 100%;
  margin-bottom: 0;
  border: 1.5px solid var(--dash-card-border);
  border-radius: 8px;
  overflow: hidden;
}

/* Blue header - override Bootstrap dark/light themes */
.table thead.table-blue {
  --bs-table-bg: var(--dash-accent);
  --bs-table-accent-bg: transparent;
  --bs-table-border-color: rgba(255,255,255,0.15);
  background-color: var(--dash-accent) !important;
  color: #ffffff !important;
}

.table thead.table-blue tr,
.table thead.table-blue th {
  background-color: var(--dash-accent) !important;
  color: #ffffff !important;
