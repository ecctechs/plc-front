                <span v-else class="badge bg-danger px-4 py-2 fs-5">{{ locale.t('OFF') }}</span>
              </div>
              <small class="text-muted d-block font-monospace bg-light p-1 rounded">{{ plcAddresses.plc_address_reject || locale.t('Address N/A') }}</small>
            </div>
