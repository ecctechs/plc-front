                      :disabled="!isSimulate"
                      @click="onInputChange(device, true)"
                    >
                      ON
                    </button>
                  </div>
                </div>
              </template>

              <template v-else-if="hasRange(device)">
                <div class="mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">{{ locale.t('Value') }}: <strong>{{ device.last_value ?? 0 }}</strong></span>
