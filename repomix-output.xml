.layout-selector select:focus {
  outline: none;
  border-color: #0d6efd;
  box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
}

/* ===== Interaction Page ===== */
.interaction-page {
  width: 100%;
