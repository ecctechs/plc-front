          <span v-if="loading" class="spinner-border spinner-border-sm me-2"></span>
          <i v-else class="fas fa-save me-2"></i>
          {{ loading ? locale.t('Saving...') : locale.t('Save All Working Time Settings') }}
        </button>
      </div>
