                    :disabled="!isSimulate"
                    @input="onInputChange(device, $event.target.value)"
                  >

                  <input
                    type="number"
                    class="form-control form-control-sm mt-2"
                    :value="device.last_value"
                    :disabled="!isSimulate"
                    @input="onInputChange(device, $event.target.value)"
                  />
                </div>
              </template>
            </div>

          </div>
        </div>
